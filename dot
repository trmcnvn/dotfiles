#!/bin/sh
set -eu

DOTFILES="$(cd "$(dirname "$0")" && pwd)"

SETUP_REGISTRY='Homebrew|brew|install_homebrew
Homebrew packages|-|install_packages
Stow dotfiles|stow|cmd_sync
Mise tools|mise|install_mise_tools
Pi|-|install_pi
Pi packages|-|update_pi_packages
Herdr Pi integration|herdr|setup_herdr_pi_integration
Bash shell|-|setup_bash
macOS defaults|-|apply_macos_defaults'

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RESET='\033[0m'

msg()  { printf "${GREEN}=>${RESET} %s\n" "$1"; }
warn() { printf "${YELLOW}=>${RESET} %s\n" "$1"; }
err()  { printf "${RED}=>${RESET} %s\n" "$1" >&2; }
die()  { err "$1"; exit 1; }
has()  { command -v "$1" >/dev/null 2>&1; }

progress() {
    CURRENT_STEP=$((CURRENT_STEP + 1))
    msg "[$CURRENT_STEP/$TOTAL_STEPS] $1"
}

require_no_args() {
    command_name=$1
    shift
    [ "$#" -eq 0 ] || die "Usage: dot $command_name"
}

confirm() {
    prompt=$1
    default=${2:-n}
    answer=""

    if [ "$default" = "y" ]; then
        suffix="[Y/n]"
    else
        suffix="[y/N]"
    fi

    if [ ! -t 0 ]; then
        [ "$default" = "y" ]
        return
    fi

    printf "%s %s " "$prompt" "$suffix"
    read -r answer || true

    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        n|N|no|NO) return 1 ;;
        "") [ "$default" = "y" ] && return 0 || return 1 ;;
        *) return 1 ;;
    esac
}

require_macos() {
    [ "$(uname -s)" = "Darwin" ] || die "Unsupported OS (macOS only)"
}

install_homebrew() {
    has brew && return 0
    msg "Installing Homebrew..."
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
}

append_line_if_missing() {
    line=$1
    file=$2
    grep -Fqx "$line" "$file" 2>/dev/null && return 0
    printf "%s\n" "$line" >> "$file"
}

has_package_equivalent() {
    case "$1" in
        openssh) has ssh ;;
        unzip) has unzip ;;
        docker-compose)
            has docker-compose || { has docker && docker compose version >/dev/null 2>&1; }
            ;;
        *) return 1 ;;
    esac
}

collect_package_status() {
    PKG_TOTAL=0
    PKG_MISSING_COUNT=0
    PKG_MISSING_LIST=""

    add_missing() {
        PKG_MISSING_COUNT=$((PKG_MISSING_COUNT + 1))
        if [ -z "$PKG_MISSING_LIST" ]; then
            PKG_MISSING_LIST=$1
        else
            PKG_MISSING_LIST="$PKG_MISSING_LIST
$1"
        fi
    }

    has brew || die "Homebrew not installed"
    installed_formulae=$(brew list --formula 2>/dev/null || true)
    installed_casks=$(brew list --cask 2>/dev/null || true)

    while IFS= read -r line; do
        case "$line" in
            \#*|"") continue ;;
        esac

        if echo "$line" | grep -q '^brew'; then
            pkg=$(echo "$line" | sed 's/brew "\([^"]*\)".*/\1/')
            PKG_TOTAL=$((PKG_TOTAL + 1))
            echo "$installed_formulae" | grep -qx "$pkg" || has_package_equivalent "$pkg" || add_missing "brew:$pkg"
        elif echo "$line" | grep -q '^cask'; then
            pkg=$(echo "$line" | sed 's/cask "\([^"]*\)".*/\1/')
            PKG_TOTAL=$((PKG_TOTAL + 1))
            echo "$installed_casks" | grep -qx "$pkg" || add_missing "cask:$pkg"
        fi
    done < "$DOTFILES/packages/brew"
}

install_brew_package() {
    package_type=$1
    package_name=$2

    case "$package_type" in
        brew) brew install "$package_name" ;;
        cask) brew install --cask "$package_name" ;;
        *) die "Unsupported package type: $package_type" ;;
    esac
}

install_packages() {
    msg "Installing Homebrew packages..."
    if brew bundle --file="$DOTFILES/packages/brew"; then
        msg "Homebrew packages installed"
        return 0
    fi

    warn "Homebrew bundle partially failed; retrying missing packages individually"
    collect_package_status
    if [ "$PKG_MISSING_COUNT" -eq 0 ]; then
        warn "Homebrew bundle failed, but all configured packages are available"
        return 0
    fi

    while IFS=: read -r package_type package_name <&3; do
        msg "Retrying $package_type package: $package_name"
        if install_brew_package "$package_type" "$package_name"; then
            msg "Installed $package_name"
        else
            warn "Failed to install $package_name"
        fi
    done 3<<EOF
$PKG_MISSING_LIST
EOF

    collect_package_status
    if [ "$PKG_MISSING_COUNT" -gt 0 ]; then
        err "Failed to install $PKG_MISSING_COUNT configured packages:"
        printf "%s\n" "$PKG_MISSING_LIST" | while IFS= read -r package; do
            err "  $package"
        done
        return 1
    fi

    msg "All configured packages are available"
}

run_setup_steps() {
    TOTAL_STEPS=$(printf "%s\n" "$SETUP_REGISTRY" | awk 'NF { count++ } END { print count + 0 }')
    CURRENT_STEP=0

    while IFS='|' read -r step_name check_command installer <&3; do
        [ -n "$step_name" ] || continue
        progress "$step_name"
        "$installer"
    done 3<<EOF
$SETUP_REGISTRY
EOF
}

setup_bash() {
    bash_path="/bin/bash"

    if [ "$SHELL" != "$bash_path" ]; then
        msg "Setting Bash as default shell..."
        chsh -s "$bash_path"
    else
        msg "Bash is already default shell"
    fi
}

apply_macos_defaults() {
    msg "Applying macOS defaults..."

    # Keyboard
    defaults write -g ApplePressAndHoldEnabled -bool false
    defaults write NSGlobalDomain KeyRepeat -int 2
    defaults write NSGlobalDomain InitialKeyRepeat -int 15
    defaults write com.microsoft.VSCode ApplePressAndHoldEnabled -bool false

    # Disable Dashboard
    defaults write com.apple.dashboard mcx-disabled -bool true

    # Disable smart characters
    defaults write NSGlobalDomain NSAutomaticQuoteSubstitutionEnabled -bool false
    defaults write NSGlobalDomain NSAutomaticDashSubstitutionEnabled -bool false
    defaults write NSGlobalDomain NSAutomaticSpellingCorrectionEnabled -bool false

    # Mouse/trackpad speed
    defaults write -g com.apple.trackpad.scaling 2
    defaults write -g com.apple.mouse.scaling 2.5

    # Disable .DS_Store on network drives
    defaults write com.apple.desktopservices DSDontWriteNetworkStores -bool true

    # Disable quarantine warnings
    defaults write com.apple.LaunchServices LSQuarantine -bool false

    # Dark mode
    defaults write NSGlobalDomain AppleInterfaceStyle -string "Dark"
    defaults write NSGlobalDomain AppleAquaColorVariant -int 6
    defaults write NSGlobalDomain AppleHighlightColor -string "0.847059 0.847059 0.862745"
    defaults write com.apple.menuextra.battery ShowPercent -bool true

    # Window drag gesture
    defaults write -g NSWindowShouldDragOnGesture YES

    # Finder
    defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"
    defaults write com.apple.finder _FXShowPosixPathInTitle -bool true
    defaults write com.apple.finder FXEnableExtensionChangeWarning -bool false
    defaults write com.apple.finder _FXSortFoldersFirst -bool true
    defaults write com.apple.finder FXDefaultSearchScope -string "SCcf"
    defaults write com.apple.finder CreateDesktop false
    defaults write com.apple.finder WarnOnEmptyTrash -bool false
    defaults write NSGlobalDomain NSDocumentSaveNewDocumentsToCloud -bool false
    defaults write NSGlobalDomain NSTableViewDefaultSizeMode -int 1

    # Disable Photos hotplug
    defaults -currentHost write com.apple.ImageCapture disableHotPlug -bool true

    # Chrome - disable swipe navigation
    defaults write com.google.Chrome AppleEnableSwipeNavigateWithScrolls -bool false

    # Dock
    defaults write com.apple.dock mru-spaces -bool false
    defaults write com.apple.dock tilesize -int 45
    defaults write com.apple.dock expose-animation-duration -float 0.1
    defaults write com.apple.dock "expose-group-by-app" -bool true
    defaults write com.apple.dock autohide-delay -float 0
    defaults write com.apple.dock autohide-time-modifier -float 0
    defaults write com.apple.dock autohide -bool true
    defaults write com.apple.dock launchanim -bool false
    defaults write com.apple.dock show-recents -bool false
    defaults write com.apple.dock persistent-apps -array
    defaults write com.apple.dock static-only -bool true

    # Screenshots
    defaults write com.apple.screencapture disable-shadow -bool true
    defaults write com.apple.screencapture location ~/Downloads

    # Restart affected apps
    for app in "Dock" "Finder" "SystemUIServer"; do
        killall "$app" >/dev/null 2>&1 || true
    done

    msg "macOS defaults applied (some may require logout)"
}

install_mise_tools() {
    has mise || die "mise not installed"
    msg "Installing mise tools..."
    mise install
}

install_pi() {
    has mise || die "mise not installed"
    msg "Installing pi..."
    mise exec -- npm install -g --ignore-scripts @earendil-works/pi-coding-agent
}

update_pi_packages() {
    msg "Updating pi packages..."
    mise exec -- pi update --extensions
}

setup_herdr_pi_integration() {
    has herdr || die "herdr not installed"

    if herdr integration status 2>/dev/null | grep -q '^pi: current '; then
        msg "Herdr Pi integration is current"
        return 0
    fi

    integration="$HOME/.pi/agent/extensions/herdr-agent-state.ts"
    if [ -L "$integration" ]; then
        die "Managed Herdr Pi integration is outdated; update $DOTFILES/home/.pi/agent/extensions/herdr-agent-state.ts"
    fi

    msg "Installing Herdr Pi integration..."
    mkdir -p "$(dirname "$integration")"
    herdr integration install pi
}

cmd_init() {
    require_no_args init "$@"
    require_macos
    msg "Initializing dotfiles (macOS)"
    run_setup_steps
    msg "Done! Restart your shell."
}

normalize_path() {
    awk -v path="$1" 'BEGIN {
        count = split(path, parts, "/")
        depth = 0

        for (i = 1; i <= count; i++) {
            if (parts[i] == "" || parts[i] == ".") continue
            if (parts[i] == "..") {
                if (depth > 0) depth--
                continue
            }
            stack[++depth] = parts[i]
        }

        normalized = ""
        for (i = 1; i <= depth; i++) normalized = normalized "/" stack[i]
        print (normalized == "" ? "/" : normalized)
    }'
}

cleanup_stale_links() {
    managed_root=$(normalize_path "$DOTFILES/home")
    managed_root_physical=$(cd "$DOTFILES/home" && pwd -P)

    find "$HOME" -type l -print 2>/dev/null | while IFS= read -r link; do
        [ -e "$link" ] && continue

        link_target=$(readlink "$link") || continue
        case "$link_target" in
            /*) target_path=$link_target ;;
            *) target_path=$(dirname "$link")/$link_target ;;
        esac

        resolved_target=$(normalize_path "$target_path")
        case "$resolved_target" in
            "$managed_root"/*|"$managed_root_physical"/*)
                relative_link=${link#"$HOME"/}
                warn "Removing stale link ~/$relative_link"
                rm -f "$link"
                ;;
        esac
    done
}

setup_ghostty_platform_config() {
    ghostty_dir="$HOME/.config/ghostty"
    ghostty_platform_config="config.macos"

    mkdir -p "$ghostty_dir"
    if [ -e "$ghostty_dir/config.local" ] && [ ! -L "$ghostty_dir/config.local" ]; then
        warn "Skipping Ghostty platform config; config.local exists and is not a symlink"
        return 0
    fi

    ln -sfn "$ghostty_platform_config" "$ghostty_dir/config.local"
    msg "Ghostty platform config -> $ghostty_platform_config"
}

cmd_sync() {
    require_no_args sync "$@"
    msg "Syncing dotfiles..."
    has stow || die "GNU Stow not installed"
    cleanup_stale_links

    # Dry-run to find conflicts, then backup+remove before stowing
    dry_run_output=$(stow --no-folding -R -n -d "$DOTFILES" -t ~ home 2>&1 || true)
    conflicts=$(printf "%s\n" "$dry_run_output" | awk '
        /existing target is not owned by stow:/ {
            sub(/^.*existing target is not owned by stow: /, "", $0)
            print
            next
        }
        /over existing target / {
            sub(/^.*over existing target /, "", $0)
            sub(/ since.*/, "", $0)
            print
        }
    ' | sort -u)
    if [ -n "$conflicts" ]; then
        warn "Stow conflicts found:"
        printf "%s\n" "$conflicts" | while IFS= read -r file; do
            warn "  ~/$file"
        done

        confirm "Backup + replace conflicting paths?" y || die "Aborted; resolve conflicts manually then re-run sync"

        backup_dir="$DOTFILES/backups/$(date +%Y%m%d_%H%M%S)"
        msg "Backing up conflicts to $backup_dir"

        printf "%s\n" "$conflicts" | while IFS= read -r file; do
            target="$HOME/$file"
            [ -e "$target" ] || [ -L "$target" ] || continue

            backup_path="$backup_dir/$file"
            mkdir -p "$(dirname "$backup_path")"

            if [ -d "$target" ] && [ ! -L "$target" ]; then
                cp -R "$target" "$backup_path"
            else
                cp -P "$target" "$backup_path"
            fi

            warn "Replacing ~/$file"
            rm -rf "$target"
        done
    fi

    stow --no-folding -R -v -d "$DOTFILES" -t ~ home
    setup_ghostty_platform_config
}

cmd_update() {
    require_no_args update "$@"
    require_macos
    TOTAL_STEPS=6
    CURRENT_STEP=0

    progress "Repository"
    if [ -d "$DOTFILES/.jj" ] && has jj; then
        (cd "$DOTFILES" && jj git fetch && jj rebase -d 'trunk()')
    else
        git -C "$DOTFILES" pull
    fi

    progress "Homebrew packages"
    install_homebrew
    brew update
    install_packages
    brew upgrade

    progress "Stow dotfiles"
    cmd_sync

    progress "Mise tools"
    install_mise_tools

    progress "Pi and configured packages"
    install_pi
    update_pi_packages

    progress "Herdr Pi integration"
    setup_herdr_pi_integration
    msg "Update complete"
}

cmd_check_packages() {
    require_no_args check-packages "$@"
    require_macos
    msg "Checking package state (macOS)..."

    collect_package_status

    installed_count=$((PKG_TOTAL - PKG_MISSING_COUNT))
    if [ "$PKG_MISSING_COUNT" -eq 0 ]; then
        printf "${GREEN}✓${RESET} All %s/%s configured packages installed\n" "$installed_count" "$PKG_TOTAL"
    else
        printf "${YELLOW}!${RESET} %s/%s configured packages installed\n" "$installed_count" "$PKG_TOTAL"
        printf "Missing:\n%s\n" "$PKG_MISSING_LIST"
    fi
}

cmd_doctor() {
    require_no_args doctor "$@"
    require_macos
    failures=0

    doctor_ok() {
        printf "${GREEN}✓${RESET} %s\n" "$1"
    }

    doctor_warn() {
        printf "${YELLOW}!${RESET} %s\n" "$1"
    }

    doctor_fail() {
        printf "${RED}✗${RESET} %s\n" "$1"
        failures=$((failures + 1))
    }

    msg "Checking dotfiles health..."

    while IFS='|' read -r step_name check_command installer <&3; do
        [ "$check_command" = "-" ] && continue
        if has "$check_command"; then
            doctor_ok "$check_command available for $step_name"
        else
            doctor_fail "$check_command missing for $step_name"
        fi
    done 3<<EOF
$SETUP_REGISTRY
EOF

    if has git; then
        doctor_ok "git installed"
    else
        doctor_fail "git missing"
    fi

    if [ -d "$DOTFILES/.jj" ]; then
        if has jj; then
            doctor_ok "jj available for this repo"
        else
            doctor_fail ".jj repo detected but jj missing"
        fi
    fi

    if has brew; then
        collect_package_status
        if [ "$PKG_MISSING_COUNT" -eq 0 ]; then
            doctor_ok "All $PKG_TOTAL configured packages installed"
        else
            doctor_fail "$PKG_MISSING_COUNT of $PKG_TOTAL configured packages missing"
            printf "%s\n" "$PKG_MISSING_LIST" | while IFS= read -r package; do
                printf "  %s\n" "$package"
            done
        fi
    fi

    if [ -L "$HOME/.config/nushell/config.nu" ] && [ -e "$HOME/.config/nushell/config.nu" ]; then
        doctor_ok "Dotfiles stowed"
    else
        doctor_fail "Dotfiles not stowed"
    fi

    if has stow; then
        if stow_output=$(stow --no-folding -R -n -d "$DOTFILES" -t "$HOME" home 2>&1); then
            doctor_ok "Stow dry-run has no conflicts"
        else
            doctor_fail "Stow dry-run failed"
            printf "%s\n" "$stow_output" | tail -10 | while IFS= read -r line; do
                printf "  %s\n" "$line"
            done
        fi
    fi

    broken_links=$(find \
        "$HOME/.agents" \
        "$HOME/.config" \
        "$HOME/.local/bin" \
        "$HOME/.pi/agent/extensions" \
        "$HOME/.pi/agent/skills" \
        \( -name node_modules -o -name .git \) -prune -o \
        -type l ! -exec test -e {} \; -print 2>/dev/null || true)
    if [ -z "$broken_links" ]; then
        doctor_ok "No broken runtime links"
    else
        broken_count=$(printf "%s\n" "$broken_links" | awk 'NF { count++ } END { print count + 0 }')
        doctor_fail "$broken_count broken runtime links"
        printf "%s\n" "$broken_links" | while IFS= read -r link; do
            printf "  %s\n" "$link"
        done
    fi

    ghostty_platform_config="$HOME/.config/ghostty/config.local"
    if [ -L "$ghostty_platform_config" ] && [ "$(readlink "$ghostty_platform_config")" = "config.macos" ] && [ -e "$ghostty_platform_config" ]; then
        doctor_ok "Ghostty uses config.macos"
    else
        doctor_fail "Ghostty config.local is not linked to config.macos"
    fi

    mise_config="$DOTFILES/home/.config/mise/config.toml"
    if has mise; then
        if grep -Eq '= *"latest"' "$mise_config"; then
            doctor_fail "Mise config contains floating tool versions"
        elif missing_tools=$(mise ls --current --missing --no-header 2>/dev/null) && [ -z "$missing_tools" ]; then
            mise_tool_count=$(mise ls --current --no-header 2>/dev/null | awk 'NF { count++ } END { print count + 0 }')
            doctor_ok "$mise_tool_count pinned Mise tools installed"
        else
            doctor_fail "Pinned Mise tools missing"
            [ -z "${missing_tools:-}" ] || printf "%s\n" "$missing_tools" | while IFS= read -r tool; do
                printf "  %s\n" "$tool"
            done
        fi
    fi

    invalid_json=""
    json_count=0
    if has jq; then
        json_count=$(find "$DOTFILES/home" -type f -name '*.json' ! -path "$DOTFILES/home/.config/zed/*" -print | awk 'END { print NR }')
        invalid_json=$(find "$DOTFILES/home" -type f -name '*.json' ! -path "$DOTFILES/home/.config/zed/*" -exec sh -c '
            for file do
                jq empty "$file" >/dev/null 2>&1 || printf "%s\n" "$file"
            done
        ' sh {} +)
        if [ -z "$invalid_json" ]; then
            doctor_ok "$json_count strict JSON configs valid"
        else
            doctor_fail "Invalid JSON configs"
            printf "%s\n" "$invalid_json" | while IFS= read -r file; do
                printf "  %s\n" "$file"
            done
        fi
    else
        doctor_fail "jq missing; cannot validate JSON configs"
    fi

    if has nu && nu --no-config-file -c "nu-check '$DOTFILES/home/.config/nushell/config.nu'" >/dev/null 2>&1; then
        doctor_ok "Nushell config parses"
    else
        doctor_fail "Nushell config does not parse"
    fi

    if has nvim && nvim --headless -u "$DOTFILES/home/.config/nvim/init.lua" +qa >/dev/null 2>&1; then
        doctor_ok "Neovim starts headlessly"
    else
        doctor_fail "Neovim headless startup failed"
    fi

    if ! has mise || ! pi_version=$(mise exec -- pi --version 2>/dev/null); then
        doctor_fail "Pi unavailable through Mise"
    else
        doctor_ok "Pi $pi_version available through Mise"

        settings="$DOTFILES/home/.pi/agent/settings.json"
        if has jq && configured_pi_packages=$(jq -r '.packages // [] | length' "$settings" 2>/dev/null); then
            if pi_list=$(PI_OFFLINE=1 mise exec -- pi list --no-approve 2>/dev/null); then
                installed_pi_packages=$(printf "%s\n" "$pi_list" | awk '/^    \// { count++ } END { print count + 0 }')
                if [ "$installed_pi_packages" -eq "$configured_pi_packages" ]; then
                    doctor_ok "All $configured_pi_packages Pi packages installed"
                else
                    doctor_fail "$installed_pi_packages of $configured_pi_packages Pi packages installed"
                fi
            else
                doctor_fail "Unable to inspect Pi packages offline"
            fi
        else
            doctor_fail "Unable to read configured Pi packages"
        fi
    fi

    if has herdr; then
        if herdr integration status 2>/dev/null | grep -q '^pi: current '; then
            doctor_ok "Herdr Pi integration current"
        else
            doctor_fail "Herdr Pi integration missing or outdated"
        fi
    fi

    if find "$HOME/Library/Fonts" /Library/Fonts -maxdepth 1 -iname 'MonoLisaCode*' -print -quit 2>/dev/null | grep -q .; then
        doctor_ok "MonoLisaCode installed"
    else
        doctor_warn "MonoLisaCode not installed (optional/manual)"
    fi

    if [ "$failures" -gt 0 ]; then
        err "$failures health checks failed"
        return 1
    fi

    msg "Doctor passed"
}

cmd_benchmark_shell() {
    runs=10
    verbose=0

    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--runs)
                shift
                [ "$#" -gt 0 ] || die "--runs requires a value"
                runs=$1
                ;;
            -v|--verbose)
                verbose=1
                ;;
            -h|--help)
                [ "$#" -eq 1 ] || die "Usage: dot benchmark-shell --help"
                cat <<EOF
Usage: dot benchmark-shell [options]

Options:
    -r, --runs <n>    Number of runs (default: 10)
    -v, --verbose     Print each run timing
    -h, --help        Show help
EOF
                return 0
                ;;
            *) die "Unknown option: $1" ;;
        esac
        shift || true
    done

    has nu || die "nushell (nu) not installed"
    has python3 || die "python3 required for benchmark-shell"

    case "$runs" in
        ''|*[!0-9]*) die "runs must be integer" ;;
    esac
    [ "$runs" -ge 1 ] || die "runs must be >= 1"

    msg "Benchmarking nushell startup ($runs runs)..."

    py_output=$(python3 - "$runs" "$verbose" <<'PY'
import subprocess
import statistics
import sys
import time

runs = int(sys.argv[1])
verbose = int(sys.argv[2]) == 1
times = []

for i in range(runs):
    start = time.perf_counter()
    subprocess.run(["nu", "-c", "exit"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=True)
    elapsed = time.perf_counter() - start
    times.append(elapsed)
    if verbose:
        print(f"run {i+1}: {elapsed:.4f}s")

avg = statistics.fmean(times)
mn = min(times)
mx = max(times)
print(f"avg={avg:.4f}")
print(f"min={mn:.4f}")
print(f"max={mx:.4f}")
PY
)

echo "$py_output" | while IFS= read -r line; do
    case "$line" in
        run*) printf "%s\n" "$line" ;;
        avg=*) avg=${line#avg=} ;;
        min=*) min=${line#min=} ;;
        max=*) max=${line#max=} ;;
    esac
done

avg=$(printf "%s\n" "$py_output" | grep '^avg=' | sed 's/^avg=//')
min=$(printf "%s\n" "$py_output" | grep '^min=' | sed 's/^min=//')
max=$(printf "%s\n" "$py_output" | grep '^max=' | sed 's/^max=//')

printf "avg: %ss\n" "$avg"
printf "min: %ss\n" "$min"
printf "max: %ss\n" "$max"

awk -v a="$avg" 'BEGIN {
    if (a <= 0.08) print "rating: excellent";
    else if (a <= 0.15) print "rating: good";
    else if (a <= 0.30) print "rating: fair";
    else print "rating: slow";
}'
}

cmd_package_help() {
    case "${1:-}" in
        list) printf "Usage: dot package list\n" ;;
        add) printf "Usage: dot package add <name> [brew|cask]\n" ;;
        remove) printf "Usage: dot package remove <name>\n" ;;
        ""|help)
            cat <<EOF
Usage: dot package <command>

Commands:
    list                         List configured packages
    add <name> [brew|cask]       Install and add a package
    remove <name>                Remove a package from config
EOF
            ;;
        *) die "Unknown package command: $1" ;;
    esac
}

cmd_package() {
    require_macos
    subcmd=${1:-help}
    shift || true

    case "${1:-}" in
        -h|--help)
            [ "$#" -eq 1 ] || die "Usage: dot package $subcmd --help"
            cmd_package_help "$subcmd"
            return 0
            ;;
    esac

    case "$subcmd" in
        list)
            require_no_args "package list" "$@"
            grep -E '^(brew|cask) ' "$DOTFILES/packages/brew" || true
            ;;
        add)
            [ "$#" -le 2 ] || die "Usage: dot package add <name> [brew|cask]"
            pkg=${1:-}
            [ -n "$pkg" ] || die "Usage: dot package add <name> [brew|cask]"
            kind=${2:-brew}
            [ "$kind" = "brew" ] || [ "$kind" = "cask" ] || die "Kind must be brew or cask"
            line="$kind \"$pkg\""

            if grep -Fqx "$line" "$DOTFILES/packages/brew"; then
                warn "$pkg is already configured"
                return 0
            fi

            msg "Installing $kind package: $pkg"
            install_brew_package "$kind" "$pkg"
            append_line_if_missing "$line" "$DOTFILES/packages/brew"
            msg "Added package to packages/brew: $line"
            ;;
        remove)
            [ "$#" -eq 1 ] || die "Usage: dot package remove <name>"
            pkg=$1
            if ! grep -Fqx "brew \"$pkg\"" "$DOTFILES/packages/brew" && ! grep -Fqx "cask \"$pkg\"" "$DOTFILES/packages/brew"; then
                warn "$pkg is not configured"
                return 0
            fi

            tmp=$(mktemp)
            awk -v p="$pkg" '
                {
                    line=$0
                    if (line ~ /^(brew|cask) "/) {
                        name=line
                        sub(/^(brew|cask) "/, "", name)
                        sub(/".*/, "", name)
                        if (name == p) next
                    }
                    print line
                }
            ' "$DOTFILES/packages/brew" > "$tmp"
            mv "$tmp" "$DOTFILES/packages/brew"
            msg "Removed package from packages/brew: $pkg"
            ;;
        help)
            require_no_args "package help" "$@"
            cmd_package_help
            ;;
        *) die "Unknown package command: $subcmd" ;;
    esac
}

cmd_link() {
    require_no_args link "$@"
    target_dir=/usr/local/bin
    if [ ! -w "$target_dir" ]; then
        target_dir="$HOME/.local/bin"
        mkdir -p "$target_dir"
    fi

    ln -sf "$DOTFILES/dot" "$target_dir/dot"
    msg "Linked dot -> $target_dir/dot"
    msg "Ensure $target_dir is in PATH"
}

cmd_unlink() {
    require_no_args unlink "$@"
    removed=0
    for path in /usr/local/bin/dot "$HOME/.local/bin/dot"; do
        if [ -L "$path" ]; then
            rm -f "$path"
            msg "Removed $path"
            removed=1
        fi
    done

    [ "$removed" -eq 1 ] || warn "No dot symlink found"
}

cmd_completions() {
    require_no_args completions "$@"
    nu_file="$DOTFILES/home/.config/nushell/scripts/dot-completions.nu"

    mkdir -p "$(dirname "$nu_file")"

    cat > "$nu_file" <<'EOF'
def "nu-complete dot commands" [] {
    [
        "init"
        "sync"
        "update"
        "doctor"
        "check-packages"
        "package"
        "benchmark-shell"
        "link"
        "unlink"
        "completions"
        "help"
    ]
}

def "nu-complete dot package commands" [] {
    ["list", "add", "remove", "help"]
}

def "nu-complete dot package kinds" [] {
    ["brew", "cask"]
}

extern "dot" [
    command?: string@"nu-complete dot commands"
]

extern "dot package" [
    subcommand?: string@"nu-complete dot package commands"
    package?: string
    kind?: string@"nu-complete dot package kinds"
]

extern "dot benchmark-shell" [
    --runs(-r): int
    --verbose(-v)
    --help(-h)
]
EOF

    msg "Generated completions:"
    msg "  $nu_file"
}

cmd_help() {
    case "${1:-}" in
        init) printf "Usage: dot init\n" ;;
        sync) printf "Usage: dot sync\n" ;;
        update) printf "Usage: dot update\n" ;;
        doctor) printf "Usage: dot doctor\n" ;;
        check-packages) printf "Usage: dot check-packages\n" ;;
        package) cmd_package_help ;;
        benchmark-shell)
            cat <<EOF
Usage: dot benchmark-shell [options]

Options:
    -r, --runs <n>    Number of runs (default: 10)
    -v, --verbose     Print each run timing
EOF
            ;;
        link) printf "Usage: dot link\n" ;;
        unlink) printf "Usage: dot unlink\n" ;;
        completions) printf "Usage: dot completions\n" ;;
        ""|help)
            cat <<EOF
Usage: dot <command>

Commands:
    init      Full setup (packages, stow, shell, plugins)
    sync      Re-stow dotfiles
    update    Pull latest changes and sync
    doctor    Run health checks
    check-packages  Check configured package coverage
    package   Manage package config (list/add/remove)
    benchmark-shell Benchmark nushell startup time
    link      Symlink dot into PATH
    unlink    Remove dot symlink from PATH
    completions Generate shell completions into dotfiles
    help      Show this message
EOF
            ;;
        *) die "Unknown command: $1" ;;
    esac
}

cmd=${1:-help}
shift || true

case "${1:-}" in
    -h|--help)
        case "$cmd" in
            init|sync|update|doctor|check-packages|package|benchmark-shell|link|unlink|completions)
                [ "$#" -eq 1 ] || die "Usage: dot $cmd --help"
                cmd_help "$cmd"
                exit 0
                ;;
        esac
        ;;
esac

case "$cmd" in
    init)   cmd_init "$@" ;;
    sync)   cmd_sync "$@" ;;
    update) cmd_update "$@" ;;
    doctor) cmd_doctor "$@" ;;
    check-packages) cmd_check_packages "$@" ;;
    package) cmd_package "$@" ;;
    benchmark-shell) cmd_benchmark_shell "$@" ;;
    link) cmd_link "$@" ;;
    unlink) cmd_unlink "$@" ;;
    completions) cmd_completions "$@" ;;
    help)
        [ "$#" -le 1 ] || die "Usage: dot help [command]"
        cmd_help "${1:-}"
        ;;
    -h|--help)
        require_no_args help "$@"
        cmd_help
        ;;
    *) err "Unknown command: $cmd"; cmd_help; exit 1 ;;
esac
